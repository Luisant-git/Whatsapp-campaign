// Central database - stores tenant metadata only
generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/client-central"
}

datasource db {
  provider = "postgresql"
  url      = env("CENTRAL_DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model Admin {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tenant {
  id          Int      @id @default(autoincrement())
  email       String   @unique
  name        String?
  companyName  String?
  contactPersonName  String?
  phoneNumber  String?
  companyAddress  String?
  city         String?
  pincode     String?
  state       String?
  country     String?
  password    String
  isActive    Boolean  @default(true)
  domain      String?  @unique
  dbName      String   @unique
  dbHost      String   @default("localhost")
  
  dbPort      Int      @default(5432)
  dbUser      String
  dbPassword  String
  subscriptionId Int?
  subscriptionStartDate DateTime?
  subscriptionEndDate DateTime?
  
  // WhatsApp Business API credentials
  accessToken String?
  wabaId      String?
  phoneNumberId String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  subscription SubscriptionPlan? @relation(fields: [subscriptionId], references: [id])
  subscriptionOrders SubscriptionOrder[]
   phoneNumbers PhoneNumberMapping[]
  metaPageMappings MetaPageMapping[]
  metaConnections MetaConnection[]
  billingAccount BillingAccount?

  menuPermission MenuPermission?
   subUsers    SubUser[]  
   notes       TenantNote[]  
}

model SubUser {
  id           Int      @id @default(autoincrement())
  tenantId     Int      // <-- foreign key to Tenant
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  email        String   @unique
  password     String
  mobileNumber String   @unique
  designation  String?
  menuPermission SubUserMenuPermission? 
  role         String   @default("staff")
  isActive     Boolean  @default(true)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([role])
  @@index([tenantId])
}

model SubUserMenuPermission {
  id          Int      @id @default(autoincrement())
  subUserId   Int      @unique
  subUser     SubUser  @relation(fields: [subUserId], references: [id], onDelete: Cascade)
  permission  Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


model PhoneNumberMapping {
  id            Int      @id @default(autoincrement())
  phoneNumberId String   @unique
  tenantId      Int
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
}



model SubscriptionPlan {
  id          Int      @id @default(autoincrement())
  name        String
  price       Float
  duration    Int
  userLimit   Int ?  
  features    String[]
  menuPermissions String[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  tenants     Tenant[]
  orders      SubscriptionOrder[]
}

model SubscriptionOrder {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  planId      Int
  amount      Float
  startDate   DateTime
  endDate     DateTime
  status      String   @default("pending")
  isCurrentPlan Boolean @default(false)
  createdAt   DateTime @default(now())
  
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan        SubscriptionPlan @relation(fields: [planId], references: [id])
}


model MenuPermission {
  id          Int      @id @default(autoincrement())
  tenantId    Int      @unique
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permission  Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MessageTemplate {
  id                 Int      @id @default(autoincrement())
  tenantId           Int
  templateId         String   @unique
  name               String
  category           String
  language           String
  status             String   @default("PENDING")
  components         String
  reviewRequested    Boolean  @default(false)
  reviewRequestedAt  DateTime?
  reviewReason       String?
  rejectionReason    String?
  previousCategory   String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  
  @@index([tenantId])
  @@index([status])
  @@index([category])
}


model TenantNote {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  title       String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model LandingContactSubmission {
  id                  Int      @id @default(autoincrement())
  businessName        String
  yourName            String
  whatsappNumber      String
  hasWebsite          String
  primaryGoal         String[]
  whatsappMessageSent Boolean  @default(false)
  whatsappMessageId   String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([whatsappNumber])
  @@index([createdAt])
}

model session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
}

model MetaPageMapping {

  id        Int      @id @default(autoincrement())
  pageId    String   @unique
  tenantId  Int
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

enum BillingMode {
  CUSTOMER_META
  COMPANY_ASSISTED
  PLATFORM_CREDIT
}

enum MetaBillingStatus {
  UNKNOWN
  ACTIVE
  PENDING_PAYMENT
  DISABLED
}

enum TransactionType {
  CREDIT
  DEBIT
}

// ----------------------------------------------------
// NEW ADDITIONS (Phase 1)
// ----------------------------------------------------

model MetaConnection {
  id                  Int     @id @default(autoincrement())
  tenantId            Int
  businessPortfolioId String?
  wabaId              String
  connectionStatus    String  @default("PENDING")
  onboardingStatus    String  @default("IN_PROGRESS")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  credential   MetaCredential?
  phoneNumbers MetaPhoneNumber[]

  @@unique([tenantId, wabaId])
}

model MetaCredential {
  id                   Int       @id @default(autoincrement())
  connectionId         Int       @unique
  accessTokenEncrypted String
  tokenType            String    @default("SYSTEM_USER")
  expiresAt            DateTime?
  status               String    @default("ACTIVE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  metaConnection MetaConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
}

model MetaPhoneNumber {
  id            Int     @id @default(autoincrement())
  connectionId  Int
  phoneNumberId String
  displayNumber String?
  verifiedName  String?
  qualityRating String?
  status        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  metaConnection MetaConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, phoneNumberId])
}

model BillingAccount {
  id                Int               @id @default(autoincrement())
  tenantId          Int               @unique
  billingMode       BillingMode       @default(CUSTOMER_META)
  metaBillingStatus MetaBillingStatus @default(UNKNOWN)
  saasPlanId        Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  wallet Wallet?
}

model Wallet {
  id               Int @id @default(autoincrement())
  billingAccountId Int @unique
  balancePaise     Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  billingAccount BillingAccount      @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)
  transactions   WalletTransaction[]
}

model WalletTransaction {
  id          Int             @id @default(autoincrement())
  walletId    Int
  amountPaise Int
  type        TransactionType
  description String
  referenceId String?

  createdAt DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
}